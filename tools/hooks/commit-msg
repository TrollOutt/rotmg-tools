#!/bin/sh
# rotmg-hooks:managed - installed from tools/hooks by tools/hooks/install.js.
# Second check of the commit identity, after the message is written.
. "$(dirname "$0")/rotmg-identity.sh"
rotmg_load_identity
rotmg_check_next_commit || rotmg_blocked "COMMIT"
problems=$(rotmg_message_problems < "$1")
[ -z "$problems" ] || rotmg_message_blocked "COMMIT" "$problems"
rotmg_chain_local commit-msg "$@"
exit 0
