#!/bin/sh
# rotmg-hooks:managed - installed from tools/hooks by tools/hooks/install.js.
# Refuses a merge commit made under another identity, and a merge that brings
# in local commits (not yet on any remote) made under another identity.
. "$(dirname "$0")/rotmg-identity.sh"
rotmg_load_identity
rotmg_check_next_commit || rotmg_blocked "MERGE"
foreign=$(rotmg_foreign_merged)
if [ -n "$foreign" ]; then
  echo "  merged commits under another identity:" >&2
  echo "$foreign" | head -5 | sed 's/^/    /' >&2
  rotmg_blocked "MERGE"
fi
rotmg_chain_local pre-merge-commit "$@"
exit 0
