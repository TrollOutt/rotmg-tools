#!/bin/sh
# rotmg-hooks:managed - installed from tools/hooks by tools/hooks/install.js.
# The last barrier before publication: refuses the push when any commit about
# to leave this machine has an author or committer that is not the pinned
# identity (or one allowed with rotmg.allowedIdentity). Commits already on a
# remote-tracking branch are not checked again.
. "$(dirname "$0")/rotmg-identity.sh"
rotmg_load_identity
input=$(cat)
zero=0000000000000000000000000000000000000000
foreign=$(echo "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    rotmg_foreign_commits "$remote_sha..$local_sha" --not --remotes | sed "s|^|$local_ref |"
  else
    rotmg_foreign_commits "$local_sha" --not --remotes | sed "s|^|$local_ref |"
  fi
done)
if [ -n "$foreign" ]; then
  echo "" >&2
  echo "PUSH BLOCKED - commits about to be published carry another identity:" >&2
  echo "$foreign" | head -10 | sed 's/^/    /' >&2
  echo "  pinned: $expected" >&2
  echo "  Rewrite them (git commit --amend --reset-author, or a rebase) before pushing." >&2
  echo "" >&2
  exit 1
fi
if [ -f "$rotmg_hooks_dir/pre-push.local" ]; then
  echo "$input" | sh "$rotmg_hooks_dir/pre-push.local" "$@" || exit $?
fi
exit 0
