#!/bin/sh
# rotmg-hooks:managed - installed from tools/hooks by tools/hooks/install.js.
# The last barrier before publication. Refuses the push when anything about to
# leave this machine names another identity:
# - a commit whose author or committer is not the pinned identity (or one
#   allowed with rotmg.allowedIdentity);
# - a commit or annotated-tag message with an address that is not allowed;
# - an annotated tag (or a tag it points to) whose tagger is not allowed;
# - a pushed git note (refs/notes/*) with such an address or private term.
# Only commits already on a branch of the remote being pushed to (as last
# fetched) are skipped; when it is given as a URL, everything is checked.
. "$(dirname "$0")/rotmg-identity.sh"
rotmg_load_identity
remote=$1
if git config --get "remote.$remote.url" >/dev/null 2>&1; then
  published="--remotes=$remote/*"
else
  published="--remotes=rotmg-no-remote-ref/*"
fi
input=$(cat)
zero=0000000000000000000000000000000000000000
problems=$(echo "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  # Annotated tags, following tags of tags down to what they point at.
  object=$local_sha
  depth=0
  while [ "$(git cat-file -t "$object" 2>/dev/null)" = tag ] && [ $depth -lt 20 ]; do
    tagger=$(git cat-file tag "$object" | sed -n 's/^tagger \(.*>\) [0-9]* [-+][0-9]*$/\1/p')
    rotmg_allowed "$tagger" || echo "$local_ref tagger ${tagger:-<none>}"
    git cat-file tag "$object" | sed '1,/^$/d' | rotmg_message_problems | sed "s|^|$local_ref tag message: |"
    object=$(git cat-file tag "$object" | sed -n 's/^object //p' | head -1)
    depth=$((depth + 1))
  done
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    range="$local_sha"
  fi
  # Only commits are checked below (a tag of a tree or blob has none).
  git cat-file -e "$local_sha^{commit}" 2>/dev/null || continue
  rotmg_foreign_commits $range --not "$published" | sed "s|^|$local_ref |"
  git log --no-mailmap --format=%B $range --not "$published" | rotmg_message_problems | sed "s|^|$local_ref commit message: |"
  # Git notes: the notes themselves are file contents of the notes commits.
  case "$local_ref" in
    refs/notes/*)
      git log --no-mailmap -p --format= $range --not "$published" | sed -n 's/^+//p' | grep -v '^++ ' \
        | rotmg_message_problems | sed "s|^|$local_ref note: |" ;;
  esac
done)
if [ -n "$problems" ]; then
  echo "" >&2
  echo "PUSH BLOCKED - what is about to be published names another identity:" >&2
  echo "$problems" | head -10 | sed 's/^/    /' >&2
  echo "  pinned: $expected" >&2
  echo "  Rewrite the commits or tags (git commit --amend --reset-author, a rebase," >&2
  echo "  or an edited message) before pushing." >&2
  echo "" >&2
  exit 1
fi
if [ -f "$rotmg_hooks_dir/pre-push.local" ]; then
  echo "$input" | sh "$rotmg_hooks_dir/pre-push.local" "$@" || exit $?
fi
exit 0
